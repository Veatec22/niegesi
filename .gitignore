# Paczki dla graczy są publikowane przez stronę, więc te akurat trzymamy w repo.
!site/public/pobierz/*.zip

# Zasoby wyciągnięte z gier do analizy — cudza zawartość, nigdy do repozytorium.
*.uasset
*.uexp
*.ucas
*.utoc
*.pak
games/*/work/*.bin
games/*/work/*.ini
games/*/work/cultures/
games/*/work/iostore/
games/*/work/assets/
games/*/work/file-list.txt
games/*/work/iostore-files.txt
# Kopie cudzego kodu do podglądu, bez ich licencji.
games/sprawl/work/UAssetGUI-Program.cs
games/sprawl/work/CRCGenerator.cs
games/labyrinth-of-the-demon-king/work/utoc-reference.go
games/*/work/interop/
# Turbo Overkill w analizie: zdekompilowany kod gry, biblioteki Unity, zrzuty zasobów.
games/turbo-overkill/work/

# Tabele innych języków z gier — dowody do biblii, cudza treść.
games/*/work/ref-*.json

# Holy Shoot: extracted assets and third-party runtime/source used for analysis.
games/holy-shoot/work/

# Neon Abyss: tabela I2 z gry (dziesięć języków) i build pluginu.
games/neon-abyss/work/

# BPM: klucz AES i pliki wyciągnięte z paków.
games/bpm/work/
games/somber-echoes/work/

# Prywatne notatki i narzędzia poza repozytorium: research, kandydaci do spolszczenia (temp/kandydaci.py).
temp/

# Katana ZERO: teksty wyciągnięte z exe gry.
games/katana-zero/work/

# NOT A HERO: zrzut tekstów INI gry do tłumaczenia.
games/not-a-hero/work/
