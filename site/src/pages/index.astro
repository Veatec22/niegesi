---
import Base from '../layouts/Base.astro';
import GameCard from '../components/GameCard.astro';
import Panel from '../components/Panel.astro';
import Search from '../components/Search.astro';
import { getGames, getStatuses, stats } from '../lib/games';

const games = await getGames();
const figures = stats(games);
const statuses = (await getStatuses())
  .map((status) => ({ ...status, count: games.filter((game) => game.status.id === status.id).length }))
  .filter((status) => status.count > 0);
---

<Base
  title="Not Geese — spolszczenia do gier"
  description="Nieoficjalne polskie tłumaczenia gier indie. Teksty, narzędzia i instrukcje instalacji dla każdego tytułu osobno."
>
  <div class="ng-shell">
    <section class="ng-hero">
      <p class="ng-label ng-hero-eyebrow">Nieoficjalne spolszczenia gier</p>
      <h1 class="ng-display ng-hero-title">Polacy<br />nie gęsi</h1>
      <div class="ng-hero-underline"></div>
      <p class="ng-hero-lead">
        Gry, które polskiej wersji nigdy nie dostały, dostają ją tutaj. Każde tłumaczenie jest
        zrobione od zera z plików gry: cały tekst, polskie znaki, działający wybór języka w menu.
      </p>
      <blockquote class="ng-hero-quote">
        A niechaj narodowie wżdy postronni znają, iż Polacy nie gęsi, iż swój język mają.
        <cite>Mikołaj Rej, 1562</cite>
      </blockquote>
    </section>
  </div>

  <div class="ng-stats">
    <div class="ng-stats-inner">
      {
        figures.map((figure) => (
          <div class="ng-stat">
            <div class="ng-stat-value">{figure.value}</div>
            <div class="ng-label ng-stat-label">{figure.label}</div>
          </div>
        ))
      }
    </div>
  </div>

  <section class="ng-section" id="gry">
    <div class="ng-shell">
      <div class="ng-section-head">
        <h2 class="ng-display ng-section-title">Spolszczenia</h2>
        <Search count={games.length} statuses={statuses} />
      </div>
      <div class="ng-grid">
        {games.map((game) => <GameCard game={game} />)}
      </div>
      <p class="ng-search-empty" data-search-empty hidden>
        Nic takiego tu nie ma — na razie. Jeśli ta gra nie ma polskiej wersji, może być następna.
      </p>
    </div>
  </section>

  <Panel games={games} />
</Base>
