---
import { render, type CollectionEntry } from 'astro:content';
import { entriesLabel, type Game } from '../lib/games';
import { downloadFor } from '../lib/download';
import Keyart from './Keyart.astro';

interface Props {
  game: Game;
  doc?: CollectionEntry<'gameDocs'>;
}

const { game, doc } = Astro.props;
const download = downloadFor(game);
const stores = Object.entries(game.stores);
const rendered = doc ? await render(doc) : null;
const Content = rendered?.Content;
---

<div class="ng-panel-scroll" data-game={game.slug} hidden>
  <Keyart game={game} variant="panel" />

  <div class="ng-panel-body">
    <div>
      <h2 class="ng-display ng-panel-title">{game.title}</h2>
      <div class="ng-panel-status" style="margin-top: var(--ng-space-4)">
        <span class="ng-badge" data-status={game.status}>
          {game.status === 'ukonczone' ? 'komplet tekstu' : `w trakcie · ${game.percent}%`}
        </span>
        <span class="ng-badge-note">wersja {game.version}</span>
        <span class="ng-badge-note">{game.testLabel}</span>
      </div>
    </div>

    {
      game.quote?.text && (
        <figure class="ng-quote" style="margin: 0">
          <span class="ng-quote-mark" aria-hidden="true">„</span>
          <p>{game.quote.text}</p>
          {game.quote.source && <cite>{game.quote.source}</cite>}
        </figure>
      )
    }

    <div class="ng-panel-actions">
      {
        download.available ? (
          <a class="ng-btn ng-btn--primary ng-on-accent" href={download.href} download>
            Pobierz spolszczenie
          </a>
        ) : (
          <span class="ng-btn ng-btn--primary" aria-disabled="true">
            {download.label}
          </span>
        )
      }
      <span class="ng-badge-note">{download.note}</span>
      {
        stores.length > 0 && (
          <div class="ng-panel-actions-row">
            {stores.map(([name, url]) => (
              <a class="ng-btn" href={url}>
                {name}
              </a>
            ))}
          </div>
        )
      }
    </div>

    <table class="ng-table">
      <tbody>
        <tr><th>Zakres</th><td>{entriesLabel(game)} — {game.scope}</td></tr>
        <tr><th>Silnik</th><td>{game.engine}</td></tr>
        <tr><th>Sposób</th><td>{game.approach}</td></tr>
        {game.source && <tr><th>Wersja gry</th><td>{game.source}</td></tr>}
      </tbody>
    </table>

    {
      Content && (
        <div class="ng-prose ng-prose--panel">
          <Content />
        </div>
      )
    }
  </div>
</div>

