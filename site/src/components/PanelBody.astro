---
import { render, type CollectionEntry } from 'astro:content';
import { entriesLabel, type Game } from '../lib/games';
import { downloadFor } from '../lib/download';
import Keyart from './Keyart.astro';

interface Props {
  game: Game;
  doc?: CollectionEntry<'gameDocs'>;
}

const { game, doc } = Astro.props;
const download = downloadFor(game);
const stores = Object.entries(game.stores);
const rendered = doc ? await render(doc) : null;
const Content = rendered?.Content;
---

<div class="ng-panel-scroll" data-game={game.slug} hidden>
  <Keyart game={game} variant="panel" />

  <div class="ng-panel-body">
    <div>
      <h2 class="ng-display ng-panel-title">{game.title}</h2>
      <div class="ng-panel-status" style="margin-top: var(--ng-space-4)">
        <span class="ng-badge" data-status={game.status}>
          {game.status === 'ukonczone' ? 'komplet tekstu' : `w trakcie · ${game.percent}%`}
        </span>
        <span class="ng-badge-note">wersja {game.version}</span>
        <span class="ng-badge-note">{game.testLabel}</span>
      </div>
    </div>

    {
      game.quote?.text && (
        <figure class="ng-quote" style="margin: 0">
          <span class="ng-quote-mark" aria-hidden="true">„</span>
          <p>{game.quote.text}</p>
          {game.quote.source && <cite>{game.quote.source}</cite>}
        </figure>
      )
    }

    <div class="ng-panel-actions">
      {
        download.install && (
          <div
            class="ng-install"
            data-install
            data-slug={game.slug}
            data-kind={download.install.kind}
            data-url={download.install.url}
            data-marker={download.install.marker}
            hidden
          >
            <button class="ng-btn ng-btn--primary ng-on-accent" type="button" data-install-button>
              Zainstaluj
            </button>
            <p class="ng-install-status" data-install-status aria-live="polite">
              Wskaż katalog gry — ten, w którym leży <code>{download.install.marker}</code>.
              {download.install.kind === 'patch'
                ? ' Łatka sprawdzi twój plik gry, nałoży się na niego i odłoży oryginał obok.'
                : ' Pliki spolszczenia zapiszą się obok gry.'}
              {' '}Gier z Program Files przeglądarka nie otworzy — wtedy pobierz paczkę.
            </p>
          </div>
        )
      }
      {
        download.available ? (
          <a class="ng-btn ng-btn--primary ng-on-accent" href={download.href} download data-download>
            Pobierz spolszczenie
          </a>
        ) : (
          <span class="ng-btn ng-btn--primary" aria-disabled="true">
            {download.label}
          </span>
        )
      }
      <span class="ng-badge-note">{download.note}</span>
      {
        stores.length > 0 && (
          <div class="ng-panel-actions-row">
            {stores.map(([name, url]) => (
              <a class="ng-btn" href={url}>
                {name}
              </a>
            ))}
          </div>
        )
      }
    </div>

    <table class="ng-table">
      <tbody>
        <tr><th>Zakres</th><td>{entriesLabel(game)} — {game.scope}</td></tr>
        <tr><th>Silnik</th><td>{game.engine}</td></tr>
        <tr><th>Sposób</th><td>{game.approach}</td></tr>
        {game.source && <tr><th>Wersja gry</th><td>{game.source}</td></tr>}
      </tbody>
    </table>

    {
      Content && (
        <div class="ng-prose ng-prose--panel">
          <Content />
        </div>
      )
    }
  </div>
</div>

<script>
  import { InstallError, installPatch, installSupported, installZip, pickGameFolder } from '../lib/install';

  if (installSupported()) {
    document.querySelectorAll<HTMLElement>('[data-install]').forEach((block) => {
      const button = block.querySelector<HTMLButtonElement>('[data-install-button]')!;
      const status = block.querySelector<HTMLElement>('[data-install-status]')!;
      const download = block.parentElement?.querySelector<HTMLAnchorElement>('[data-download]');
      const { slug, kind, url, marker } = block.dataset as Record<string, string>;

      // Z guzikiem „zainstaluj" pobieranie schodzi do roli zapasowej.
      block.hidden = false;
      download?.classList.remove('ng-btn--primary', 'ng-on-accent');
      if (download) download.textContent = 'Pobierz paczkę ZIP';

      const say = (message: string, tone?: 'ok' | 'error') => {
        status.textContent = message;
        if (tone) status.dataset.tone = tone;
        else delete status.dataset.tone;
      };

      button.addEventListener('click', async () => {
        button.disabled = true;
        try {
          const root = await pickGameFolder(slug!, marker!);
          const outcome = kind === 'patch' ? await installPatch(root, url!, say) : await installZip(root, url!, say);
          const saved = outcome.backups.length ? ` Oryginał odłożony obok: ${outcome.backups.join(', ')}.` : '';
          say(outcome.message + saved, 'ok');
        } catch (error) {
          if (error instanceof DOMException && error.name === 'AbortError') {
            say('Anulowano — nic nie zostało zapisane.');
          } else if (error instanceof InstallError) {
            say(error.message, 'error');
          } else {
            console.error(error);
            say(`Nie udało się: ${error instanceof Error ? error.message : String(error)}`, 'error');
          }
        } finally {
          button.disabled = false;
        }
      });
    });
  }
</script>
