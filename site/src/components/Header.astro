---
import GooseMark from './GooseMark.astro';
import Icon from './Icon.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import { withBase } from '../lib/url';
---

<header class="ng-header">
  <a class="ng-brand" href={withBase("/")}>
    <GooseMark class="ng-brand-mark" />
    <span class="ng-brand-name"><span class="ng-brand-not">Not</span> Geese</span>
  </a>
  <nav class="ng-nav ng-label" aria-label="Główna">
    <ThemeSwitch />
    <a class="ng-nav-github" href="https://github.com/Veatec22/niegesi" target="_blank" rel="noopener" aria-label="Repozytorium na GitHubie">
      <Icon name="github" />
    </a>
  </nav>
</header>
