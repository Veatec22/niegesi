---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<!-- Gęś przekreślona czerwoną kreską. Obrys dziedziczy kolor tekstu, kreska jest akcentem. -->
<svg
  class={className}
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="M11 29c-4 0-7-2.6-7-6.4 0-4.4 3.6-6.6 7.6-7.4" />
  <path d="M11.6 15.2c-1.6-2-2-4.2-2-5.8C9.6 5.6 12.4 3 15.8 3c3.4 0 6 2.6 6 6.2 0 4.6-3.4 6.6-3.4 10.2 0 2.4 1.6 4 1.6 6.2 0 2-1.4 3.4-3.4 3.4H11" />
  <path d="M21.6 7.6 27 8.8l-5 2" />
  <path d="M4 26.5 28 5.5" stroke="var(--ng-accent)" stroke-width="3.2" />
</svg>
