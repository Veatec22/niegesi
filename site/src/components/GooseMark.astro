---
import { withBase } from '../lib/url';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<!-- Znak: biała gęś przekreślona czerwonym pasem na czarnym tle. Ten sam plik służy za favicon. -->
<img class={className} src={withBase('favicon.svg')} alt="" width="34" height="34" />
