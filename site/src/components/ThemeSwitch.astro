---
import Icon from './Icon.astro';

/**
 * Motyw: systemowy, jasny albo ciemny, przełączane po kolei jednym przyciskiem.
 * Wybór leży w localStorage („ng-theme”) i trafia na <html data-theme>; „system” to brak
 * atrybutu, wtedy decyduje prefers-color-scheme. Pierwsze ustawienie robi skrypt w <head>
 * (Base.astro), a ikona bierze się z CSS po data-theme, więc nic nie mignie przy wczytaniu.
 */
const modes = [
  { value: 'system', icon: 'monitor' },
  { value: 'light', icon: 'sun' },
  { value: 'dark', icon: 'moon' },
] as const;
---

<button type="button" class="ng-nav-button ng-theme-toggle" aria-label="Motyw strony: systemowy" title="Motyw strony: systemowy" data-theme-toggle>
  {modes.map((mode) => <span class="ng-theme-icon" data-mode={mode.value}><Icon name={mode.icon} size={18} /></span>)}
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const order = ['system', 'light', 'dark'];
  const labels: Record<string, string> = { system: 'systemowy', light: 'jasny', dark: 'ciemny' };

  function current(): string {
    try {
      return localStorage.getItem('ng-theme') ?? 'system';
    } catch {
      return document.documentElement.dataset.theme ?? 'system';
    }
  }

  function apply(mode: string) {
    if (mode === 'light' || mode === 'dark') document.documentElement.dataset.theme = mode;
    else delete document.documentElement.dataset.theme;
    try {
      localStorage.setItem('ng-theme', mode);
    } catch {
      // Prywatne okno albo zablokowane dane: motyw działa do końca wizyty.
    }
    const label = `Motyw strony: ${labels[mode] ?? labels.system}`;
    button?.setAttribute('aria-label', label);
    button?.setAttribute('title', label);
  }

  let mode = current();
  apply(mode);

  button?.addEventListener('click', () => {
    mode = order[(order.indexOf(mode) + 1) % order.length]!;
    apply(mode);
  });
</script>
