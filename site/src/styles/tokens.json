{
  "$name": "notgoose.cc",
  "$description": "Tokeny projektowe. Te same wartości co tokens.css, w formie danych — pod konfigurację motywu (Tailwind, Panda, Style Dictionary) albo generator.",
  "color": {
    "bone": { "value": "#E9E5DB", "use": "tło strony" },
    "paper": { "value": "#FFFFFF", "use": "powierzchnie wyniesione" },
    "ink": { "value": "#14130F", "use": "tekst, ramki, cienie" },
    "accent": { "value": "#D6341F", "use": "grafika i CTA; tylko tekst ≥18.66px bold" },
    "redDeep": { "value": "#B02510", "use": "tło pod drobnym białym tekstem" },
    "navy": { "value": "#003670", "use": "status ukończone, tła keyartów" },
    "muted": { "value": "#57534A", "use": "tekst drugorzędny na jasnym" },
    "mutedInverse": { "value": "#B9B3A4", "use": "tekst drugorzędny na ink" },
    "hairline": { "value": "#C9C3B4", "use": "linie 1px wewnątrz ramek" },
    "scrim": { "value": "rgba(20, 19, 15, 0.58)", "use": "przyciemnienie pod szufladą" },
    "placeholderMark": { "value": "rgba(255, 255, 255, 0.13)", "use": "inicjał na keyarcie" }
  },
  "contrast": {
    "note": "Sprawdzone pary. Nie dodawaj nowych kombinacji bez pomiaru.",
    "pass": [
      { "fg": "#14130F", "bg": "#E9E5DB", "ratio": 15.6 },
      { "fg": "#57534A", "bg": "#E9E5DB", "ratio": 5.8 },
      { "fg": "#B9B3A4", "bg": "#14130F", "ratio": 8.4 },
      { "fg": "#FFFFFF", "bg": "#003670", "ratio": 9.6 },
      { "fg": "#FFFFFF", "bg": "#B02510", "ratio": 5.8 }
    ],
    "conditional": [
      {
        "fg": "#14130F",
        "bg": "#D6341F",
        "ratio": 4.4,
        "rule": "tylko tekst od 18.66px w grubym kroju (próg 3:1)"
      }
    ]
  },
  "font": {
    "display": { "family": "Archivo Black", "weights": [400], "source": "Google Fonts", "subsets": ["latin", "latin-ext"] },
    "body": { "family": "Space Grotesk", "weights": [400, 500, 700], "source": "Google Fonts", "subsets": ["latin", "latin-ext"] },
    "mono": { "family": "JetBrains Mono", "weights": [400, 700], "source": "Google Fonts", "subsets": ["latin", "latin-ext"] }
  },
  "type": {
    "hero": { "desktop": 118, "mobile": 46, "leading": 0.88, "tracking": "-0.035em", "font": "display", "case": "upper" },
    "section": { "desktop": 56, "mobile": 30, "leading": 1, "tracking": "-0.03em", "font": "display", "case": "upper" },
    "panelTitle": { "desktop": 40, "mobile": 28, "leading": 0.98, "tracking": "-0.03em", "font": "display", "case": "upper" },
    "cardTitle": { "desktop": 22, "mobile": 20, "leading": 1.05, "tracking": "0", "font": "display", "case": "upper" },
    "stat": { "desktop": 56, "mobile": 38, "leading": 1, "tracking": "0", "font": "display" },
    "quote": { "desktop": 21, "mobile": 15, "leading": 1.45, "tracking": "0", "font": "body" },
    "body": { "desktop": 16, "mobile": 14, "leading": 1.6, "tracking": "0", "font": "body" },
    "label": { "desktop": 12, "mobile": 10, "tracking": "0.16em", "font": "mono", "case": "upper", "weight": 700 },
    "meta": { "desktop": 11, "mobile": 10, "tracking": "0.1em", "font": "mono" }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 28, "8": 32, "10": 40, "12": 48, "16": 64, "18": 72, "20": 80 },
  "form": {
    "borderWidth": 3,
    "borderColor": "ink",
    "radius": 0,
    "radiusException": { "drawerHandle": 3 },
    "shadow": { "desktop": "8px 8px 0 #14130F", "mobile": "7px 7px 0 #14130F" },
    "shadowPressed": "4px 4px 0 #14130F",
    "shadowOpen": "8px 8px 0 #D6341F",
    "hitTarget": 44
  },
  "layout": {
    "pageMax": 1440,
    "gutter": { "desktop": 80, "mobile": 20 },
    "gridGap": { "desktop": 28, "mobile": 20 },
    "columns": { "desktop": 3, "desktopPanelOpen": 2, "tablet": 2, "mobile": 1 },
    "panelWidth": { "desktop": 560, "tablet": 480 },
    "drawerMaxHeight": "88vh",
    "keyartRatio": "16 / 9",
    "breakpoints": { "mobile": 699, "tablet": 1099 }
  },
  "motion": {
    "duration": 240,
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "reducedMotion": "przejścia wyłączone, panel pojawia się bez animacji"
  },
  "assets": {
    "keyart": { "width": 1600, "height": 900, "format": ["webp", "jpg"], "note": "nie kadruj istotnych elementów przy prawej krawędzi" }
  }
}
